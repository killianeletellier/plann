# Secret JWT — obligatoire en production (min. 32 caractères aléatoires)
JWT_SECRET=

# Clé de chiffrement AES pour récupération admin des PIN (optionnel, utilise JWT_SECRET sinon)
PIN_ENCRYPTION_KEY=

# Origines autorisées en dev uniquement (optionnel, séparées par des virgules)
# ALLOWED_DEV_ORIGINS=10.*.*.*,192.168.*.*
